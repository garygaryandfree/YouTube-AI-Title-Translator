{
  "manifest_version": 3,
  "name": "YouTube AI 标题翻译 (全能版)",
  "version": "7.2",
  "description": "一键支持 OpenAI / Gemini / Claude / DeepSeek / MiniMax / 智谱 / Kimi / 自定义端点，自动翻译 YouTube 标题。",

  "icons": {
    "16": "icon/icon16.png",
    "48": "icon/icon48.png",
    "128": "icon/icon128.png"
  },

  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icon/icon16.png",
      "32": "icon/icon32.png",
      "48": "icon/icon48.png",
      "128": "icon/icon128.png"
    },
    "default_title": "点击配置 AI"
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": ["storage"],
  "host_permissions": [
    "https://*.youtube.com/*",
    "https://api.deepseek.com/*",
    "https://api.openai.com/*",
    "https://generativelanguage.googleapis.com/*",
    "https://api.anthropic.com/*",
    "https://api.minimaxi.com/*",
    "https://api.minimax.chat/*",
    "https://open.bigmodel.cn/*",
    "https://api.moonshot.cn/*"
  ],
  "optional_host_permissions": [
    "<all_urls>"
  ],
  "content_scripts": [
    {
      "matches": ["https://*.youtube.com/*"],
      "js": ["content.js"],
      "css": ["styles.css"]
    }
  ]
}
